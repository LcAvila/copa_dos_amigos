# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_publica

# NUNCA coloque aqui a chave da football-data.org nem a service_role do Supabase.
# Elas vivem apenas como secrets do Supabase (Edge Functions).
